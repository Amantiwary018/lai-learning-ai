# ---- Web/API server (Node) ----
PORT=5000
LAI_DB_PATH=./data.db
LAI_ADMIN_EMAIL=admin@lai.app
LAI_ADMIN_PASSWORD=change-me-now
AI_GATEWAY_URL=http://127.0.0.1:8001
# Set to 0 to stop automatic video generation on boot
LAI_AUTOBUILD_VIDEOS=1

# ---- AI gateway (Python, internal only — never exposed to the browser) ----
# anthropic | openai | local
LAI_PROVIDER=anthropic
LAI_TTS_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_VOICE=alloy
LAI_TTS_CONCURRENCY=6
AI_GATEWAY_PORT=8001
